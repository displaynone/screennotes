FROM docker.io/library/rust:1.94.1-slim-bookworm AS rust
FROM docker.io/library/ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get -o Acquire::Retries=3 -o Acquire::http::Timeout=30 \
        -o APT::Update::Error-Mode=any update \
    && apt-get -o Acquire::Retries=3 -o Acquire::http::Timeout=30 \
        install -y --no-install-recommends \
    build-essential ca-certificates curl pkg-config libgtk-4-dev \
    librsvg2-dev libgirepository1.0-dev libgdk-pixbuf2.0-bin \
    adwaita-icon-theme dpkg-dev desktop-file-utils python3 file \
    patchelf squashfs-tools zsync \
    && rm -rf /var/lib/apt/lists/*
COPY --from=rust /usr/local/cargo /usr/local/cargo
COPY --from=rust /usr/local/rustup /usr/local/rustup
ENV RUSTUP_HOME=/usr/local/rustup \
    PATH=/usr/local/cargo/bin:$PATH \
    CARGO_HOME=/tmp/cargo-home \
    CARGO_TARGET_DIR=/tmp/screennotes-target
WORKDIR /source
ENTRYPOINT ["python3", "scripts/package.py"]
